{
    "name": "@richpods/validate-mp3",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "main": "build/index.js",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "gcp-build": "tsc",
        "build": "tsc",
        "clean": "rimraf build",
        "dev": "npm run build && set -a; . ./.env.development; set +a; npx @google-cloud/functions-framework --target=validateMp3 --signature-type=cloudevent --port=8081",
        "start": "npx @google-cloud/functions-framework --target=validateMp3 --signature-type=cloudevent"
    },
    "dependencies": {
        "@google-cloud/firestore": "8.3.0",
        "@google-cloud/functions-framework": "5.0.2",
        "@google-cloud/storage": "7.19.0",
        "music-metadata": "11.12.3"
    },
    "devDependencies": {
        "@tsconfig/node24": "24.0.4",
        "@types/node": "25.5.2",
        "rimraf": "6.1.3",
        "typescript": "6.0.2"
    }
}
