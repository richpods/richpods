{
    "name": "@richpods/shared",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "files": [
        "dist",
        "assets",
        "public"
    ],
    "exports": {
        "./i18n/language": {
            "types": "./dist/i18n/language.d.ts",
            "import": "./dist/i18n/language.js"
        },
        "./utils/roles": {
            "types": "./dist/utils/roles.d.ts",
            "import": "./dist/utils/roles.js"
        },
        "./utils/itunesCategories": {
            "types": "./dist/utils/itunesCategories.d.ts",
            "import": "./dist/utils/itunesCategories.js"
        },
        "./media/types": {
            "types": "./dist/media/types.d.ts",
            "import": "./dist/media/types.js"
        },
        "./media/check": {
            "types": "./dist/media/check.d.ts",
            "import": "./dist/media/check.js"
        },
        "./media/feed": {
            "types": "./dist/media/feed.d.ts",
            "import": "./dist/media/feed.js"
        },
        "./assets/*": "./assets/*",
        "./components/*": "./components/*"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "xml2js": "0.6.2"
    },
    "devDependencies": {
        "@types/xml2js": "0.4.14",
        "typescript": "catalog:"
    }
}
