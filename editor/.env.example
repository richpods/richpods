# Development defaults
VITE_GRAPHQL_ENDPOINT=http://localhost:4000/graphql
VITE_COLOEUS_ENDPOINT=http://localhost:8088

# For links to the final player
VITE_PLAYER_URL_PATTERN=http://localhost:5174/player/{ID}

# Firebase Web app config
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Optional for production builds
# VITE_APP_BASE=/editor/

# URL pattern for the auto-generated website for hosted podcasts. {ID} is replaced with the podcast ID.
VITE_WEBSITE_HOSTED_PODCAST_URL_PATTERN=https://www.richpods.org/podcast/{ID}
